# Supabase project (the deployed Page runtime injects these two)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Owner access token: you type it at /login; the QwenWork agent sends it as
# "Authorization: Bearer <APP_TOKEN>". Use a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_TOKEN=

PORT=8081
